{
  "name": "agent-workbench",
  "version": "3.7.149",
  "private": true,
  "description": "Agent 工坊 — 多场景任务 / 记录 / AI 助手单文件应用。单一交付物 agent-workbench.html 为真相源。",
  "scripts": {
    "test": "node scripts/with-injected.mjs vitest run",
    "test:local": "node scripts/with-injected.mjs node scripts/run-tests.mjs",
    "prepare": "node scripts/install-hooks.mjs",
    "test:watch": "node scripts/with-injected.mjs vitest",
    "test:coverage": "node scripts/with-injected.mjs vitest run --coverage",
    "e2e": "node scripts/with-injected.mjs node scripts/run-e2e.mjs",
    "e2e:install": "npx playwright install chromium",
    "build": "node scripts/with-injected.mjs node scripts/build.mjs",
    "build:prod": "node scripts/with-injected.mjs node scripts/build.mjs --prod",
    "make:icon": "node scripts/make-icon.mjs",
    "build:check": "node scripts/with-injected.mjs node scripts/build.mjs --check",
    "release": "node scripts/release.mjs",
    "lint": "node scripts/with-injected.mjs \"npx eslint agent-workbench.html electron/main.js electron/preload.js service-worker.js && node scripts/lint-colors.mjs agent-workbench.html && node scripts/lint-xss.mjs --check && node scripts/lint-css-structure.mjs && node scripts/lint-appbridge.mjs --check && node scripts/src-split.mjs --check && node scripts/lint-breakpoints.mjs\"",
    "lint:xss": "node scripts/lint-xss.mjs --check",
    "lint:appbridge": "node scripts/lint-appbridge.mjs --check",
    "serve": "python -m http.server 8123",
    "lint:layers": "node scripts/with-injected.mjs node scripts/lint-layers.mjs",
    "lint:tokens": "node scripts/lint-tokens.mjs",
    "lint:tokens:freeze": "node scripts/lint-tokens.mjs --freeze",
    "lint:empty-catch": "node scripts/lint-empty-catch.mjs",
    "lint:empty-catch:report": "node scripts/lint-empty-catch.mjs --report",
    "lint:empty-catch:freeze": "node scripts/lint-empty-catch.mjs --freeze",
    "lint:icons": "node scripts/lint-icons.mjs",
    "lint:server-ssrf": "node scripts/lint-server-ssrf.mjs",
    "lint:server-idor": "node scripts/lint-server-idor.mjs",
    "lint:icons:report": "node scripts/lint-icons.mjs --report",
    "lint:icons:freeze": "node scripts/lint-icons.mjs --freeze",
    "pet:inject": "node scripts/pet-art.mjs",
    "pet:extract": "node scripts/pet-art.mjs --extract",
    "verify:ci": "node scripts/verify-ci-order.mjs",
    "watch:runs": "node scripts/watch-runs.mjs",
    "pet:check": "node scripts/with-injected.mjs node scripts/pet-art.mjs --check",
    "vendor:pdfjs": "node scripts/vendor-pdfjs.mjs",
    "vendor:pdfjs:check": "node scripts/vendor-pdfjs.mjs --check",
    "vendor:mermaid": "node scripts/vendor-mermaid.mjs",
    "vendor:mermaid:check": "node scripts/vendor-mermaid.mjs --check",
    "make:pwa-icons": "node scripts/make-pwa-icons.mjs",
    "check:pwa-icons": "node scripts/make-pwa-icons.mjs --check",
    "make:ai-tools-doc": "node scripts/gen-ai-tools-doc.mjs",
    "check:ai-tools-doc": "node scripts/gen-ai-tools-doc.mjs --check",
    "src:inject": "node scripts/src-split.mjs && node scripts/pet-art.mjs",
    "src:extract": "node scripts/pet-art.mjs --extract && node scripts/src-split.mjs --extract",
    "src:check": "node scripts/src-split.mjs --check",
    "src:verify": "node scripts/src-split.mjs --verify",
    "check:source-state": "node scripts/check-source-state.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "module:graph": "node scripts/module-graph.mjs",
    "check:modules": "node scripts/module-graph.mjs --check",
    "module:freeze": "node scripts/module-graph.mjs --freeze",
    "src:move": "node scripts/src-move.mjs",
    "lint:breakpoints": "node scripts/lint-breakpoints.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^8.57.0",
    "eslint-plugin-html": "^8.1.1",
    "jsdom": "^24.1.3",
    "mermaid": "10.9.1",
    "pdfjs-dist": "^3.11.174",
    "vitest": "^2.1.9"
  }
}
