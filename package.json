{
  "name": "agent-workbench",
  "version": "3.7.50",
  "private": true,
  "description": "Agent 工坊 — 多场景任务 / 记录 / AI 助手单文件应用。单一交付物 agent-workbench.html 为真相源。",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "node scripts/run-e2e.mjs",
    "e2e:install": "npx playwright install chromium",
    "build": "node scripts/build.mjs",
    "build:prod": "node scripts/build.mjs --prod",
    "make:icon": "node scripts/make-icon.mjs",
    "build:check": "node scripts/build.mjs --check",
    "release": "node scripts/release.mjs",
    "lint": "npx eslint agent-workbench.html electron/main.js electron/preload.js service-worker.js && node scripts/lint-colors.mjs agent-workbench.html",
    "serve": "python -m http.server 8123",
    "lint:layers": "node scripts/lint-layers.mjs",
    "pet:inject": "node scripts/pet-art.mjs",
    "pet:extract": "node scripts/pet-art.mjs --extract",
    "pet:check": "node scripts/pet-art.mjs --check",
    "pretest": "node scripts/src-split.mjs && node scripts/pet-art.mjs",
    "pretest:coverage": "node scripts/src-split.mjs && node scripts/pet-art.mjs",
    "prebuild": "node scripts/src-split.mjs && node scripts/pet-art.mjs",
    "prebuild:check": "node scripts/src-split.mjs && node scripts/pet-art.mjs",
    "prebuild:prod": "node scripts/src-split.mjs && node scripts/pet-art.mjs",
    "pree2e": "node scripts/src-split.mjs && node scripts/pet-art.mjs",
    "make:pwa-icons": "node scripts/make-pwa-icons.mjs",
    "check:pwa-icons": "node scripts/make-pwa-icons.mjs --check",
    "make:ai-tools-doc": "node scripts/gen-ai-tools-doc.mjs",
    "check:ai-tools-doc": "node scripts/gen-ai-tools-doc.mjs --check",
    "src:inject": "node scripts/src-split.mjs",
    "src:extract": "node scripts/src-split.mjs --extract",
    "src:check": "node scripts/src-split.mjs --check",
    "src:verify": "node scripts/src-split.mjs --verify",
    "prelint": "node scripts/src-split.mjs && node scripts/pet-art.mjs",
    "check:source-state": "node scripts/check-source-state.mjs",
    "module:graph": "node scripts/module-graph.mjs",
    "check:modules": "node scripts/module-graph.mjs --check",
    "module:freeze": "node scripts/module-graph.mjs --freeze",
    "src:move": "node scripts/src-move.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^8.57.0",
    "eslint-plugin-html": "^8.1.1",
    "jsdom": "^24.1.3",
    "vitest": "^2.1.9"
  }
}
