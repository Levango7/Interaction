{
  // 架构项③：源码模块类型化基建（JSDoc + tsc 渐进检查）
  // 用法：npm run typecheck（对 src/modules 全量 checkJs，逐步收紧）
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "target": "ES2022",
    "module": "none",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "maxNodeModuleJsDepth": 0
  },
  "include": ["src/modules/**/*.js", "src/global.d.ts"],
  "exclude": ["node_modules"]
}
