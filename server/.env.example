# server 环境变量示例 —— 复制为 .env 后按需填写（.env 已被 .gitignore 忽略，不会入库）
# 加载方式：node >= 22.5 可直接 `node --env-file=.env src/index.js`，或在启动脚本中自行 export

# ---------- 基础 ----------
# 服务监听端口
PORT=3001
# 运行环境：production 时会强制校验 JWT 密钥（未设置或仍为默认值将拒绝启动）
NODE_ENV=development
# SQLite 数据库文件路径（默认 ./data/app.db）
# DB_PATH=./data/app.db

# ---------- JWT 密钥（生产环境必填） ----------
# 生成方式：node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ---------- 安全 ----------
# CORS 允许的 Origin 白名单，逗号分隔的完整 Origin（含协议）
# localhost / 127.0.0.1 任意端口始终放行；未设置时仅放行同源与 localhost
# CORS_ORIGINS=https://your-frontend.example.com,https://app.example.com
# 限流窗口毫秒数（默认 900000 = 15 分钟）
# RATE_WINDOW_MS=900000
# auth 路由总节流：每 IP 每窗口最大请求数（默认 60）
# AUTH_RATE_MAX=60
# 登录失败锁定：每 IP+邮箱 每窗口最大失败次数（默认 5，达到后锁定一个窗口）
# LOGIN_MAX_FAILURES=5

# ---------- 邮件 ----------
# 默认发件人（SMTP 服务器配置由用户在系统内设置，存于数据库，不走环境变量）
# MAIL_FROM=Nexus Interaction <no-reply@example.com>

# ---------- Web Push（VAPID） ----------
# 生成方式：npx web-push generate-vapid-keys
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ---------- OAuth 集成（可选，未配置时对应集成不可用） ----------
OAUTH_REDIRECT_BASE=
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
TODOIST_OAUTH_CLIENT_ID=
TODOIST_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
