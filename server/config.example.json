{
  "port": 3001,
  "jwt": {
    "accessSecret": "change-me-access-secret",
    "refreshSecret": "change-me-refresh-secret",
    "accessTtlSec": 900,
    "refreshTtlSec": 2592000
  },
  "email": {
    "enabled": false,
    "from": "Agent 工坊 <no-reply@example.com>",
    "smtp": {
      "host": "smtp.example.com",
      "port": 465,
      "secure": true,
      "user": "",
      "pass": ""
    }
  },
  "github": {
    "enabled": false,
    "clientId": "",
    "clientSecret": "",
    "redirectUri": "http://localhost:3001/api/auth/github/callback",
    "postMessageOrigin": "*"
  },
  "wechat": {
    "enabled": false,
    "appid": "",
    "secret": "",
    "qrcodeTicketTtlSec": 300,
    "pollIntervalMs": 2500
  },
  "corsOrigin": "*",
  "dev": {
    "allowUnsafeDevEndpoints": false
  },
  "security": {
    "rateLimit": {
      "enabled": true,
      "windowMs": 60000,
      "max": 30,
      "loginMax": 10,
      "emailCodeMax": 5
    }
  },
  "sync": {
    "maxSnapshotBytes": 2097152,
    "conflictPolicy": "lww"
  },
  "tools": {
    "fetch": {
      "enabled": true,
      "maxBytes": 1048576,
      "timeoutMs": 10000,
      "maxRedirects": 3,
      "allowHosts": []
    }
  },
  "dataFile": "data/auth.json"
}