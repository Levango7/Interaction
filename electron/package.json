{
  "name": "agent-workbench",
  "version": "1.1.0",
  "description": "Windows 套壳 Agent 工作台（Electron 封装，含系统托盘与开机自启）",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "prebuild": "node -e \"const fs=require('fs'),p=require('path');const s=p.resolve(__dirname,'..','agent-workbench.html'),d=p.resolve(__dirname,'agent-workbench.html');fs.copyFileSync(s,d);console.log('[prebuild] copied',p.basename(s),'->',p.basename(d))\"",
    "dist": "npm run prebuild && electron-builder --win --x64 --publish=never"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.agent.workbench",
    "productName": "Agent 工作台",
    "artifactName": "Agent工作台-${version}-portable.exe",
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "agent-workbench.html"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "portable"
      ],
      "icon": null,
      "signingHashAlgorithms": []
    },
    "publish": {
      "provider": "generic",
      "url": "https://your-update-server.com/agent-workbench/"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
