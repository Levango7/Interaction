{
  "name": "agent-workbench",
  "version": "3.4.2",
  "description": "Windows 套壳 Agent 工坊（Electron 封装，含系统托盘与开机自启）",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "prebuild": "node -e \"const fs=require('fs'),p=require('path');const s=p.resolve(__dirname,'..','agent-workbench.html'),d=p.resolve(__dirname,'agent-workbench.html');fs.copyFileSync(s,d);console.log('[prebuild] copied',p.basename(s),'->',p.basename(d))\"",
    "dist": "npm run prebuild && electron-builder --win --x64 --publish=never"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^41.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.agent.workbench",
    "productName": "Agent 工坊",
    "artifactName": "Agent工坊-${version}-portable.exe",
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "agent-workbench.html"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "portable"
      ],
      "icon": "icon.ico",
      "signingHashAlgorithms": [],
      "signAndEditExecutable": true,
      "//signing": "P1 占位：exe 当前未代码签名，Windows SmartScreen 会拦截首次启动。启用签名步骤：(1) 获取代码签名证书(.pfx)；(2) 设置环境变量 CSC_LINK=<证书路径或base64> 与 CSC_KEY_PASSWORD=<证书密码>；(3) 将 signingHashAlgorithms 改为 [\"sha256\"]；(4) 重新 npm run dist。",
      "signing": {
        "identity": null
      }
    }
  }
}
